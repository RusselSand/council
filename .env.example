# Секреты и настройки для локальной работы. Скопируйте в .env и заполните: .env не коммитится.

# Токен только на чтение приватного RusselSand/agent-workers: fine-grained token с правом
# Contents: Read только на этот репо. Нужен docker compose для сборки образов, в образ не попадает.
AGENT_WORKERS_TOKEN=

# Модели совета: каталог учётной записи CLI с подпиской для каждой. Там токены входа,
# поэтому вне репозитория. Пусто — модель в совете видна, но не запускается.
# Вход — один раз на хосте, из каталога backend:
#   uv run python -m agent_workers login --provider codex --home <COUNCIL_SOL_HOME>
#   uv run python -m agent_workers login --provider claude --home <COUNCIL_FABLE_HOME>
# Docker монтирует эти каталоги в контейнер.
COUNCIL_SOL_HOME=
COUNCIL_FABLE_HOME=
