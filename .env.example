# Секреты и настройки для локальной работы. Скопируйте в .env и заполните: .env не коммитится.

# Токен только на чтение приватного RusselSand/agent-workers: fine-grained token с правом
# Contents: Read только на этот репо. Нужен docker compose для сборки образов, в образ не попадает.
AGENT_WORKERS_TOKEN=

# Каталоги учётных записей моделей совета, если не .accounts/sol и .accounts/fable в корне
# репозитория. Там токены входа; как войти — README, «Вход в модели». Docker их монтирует.
# COUNCIL_SOL_HOME=.accounts/sol
# COUNCIL_FABLE_HOME=.accounts/fable

# Каталог советов, если не .data в корне репозитория: по файлу на совет. Docker его монтирует.
# COUNCIL_DATA=.data

# Только Linux, обязательно: контейнеры пишут в .accounts на хосте и должны работать под вами,
# иначе оставят там файлы root. Узнать: id -u, id -g. На Windows и macOS — не задавать.
# COUNCIL_UID=1000
# COUNCIL_GID=1000
